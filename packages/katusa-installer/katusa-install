#!/usr/bin/env python3
"""
katusaOS Disk Installer (katusa-install)
Interactive TUI & CLI Installer for katusaOS on UTM, QEMU, and Physical Drives.
"""

import os
import sys
import time
import argparse
import subprocess
import shutil

BANNER = "katusaOS - ★ Katusa Programming Club Dedicated Operating System ★"

def run_cmd(cmd, check=True, capture=True):
    """Run a shell command and return stdout."""
    res = subprocess.run(cmd, shell=True, text=True, capture_output=capture)
    if check and res.returncode != 0:
        err_msg = res.stderr.strip() if res.stderr else f"Command failed with exit code {res.returncode}"
        raise RuntimeError(f"Error running '{cmd}': {err_msg}")
    return res.stdout.strip() if capture else ""


def get_booted_device():
    """Find the disk from which the current rootfs is mounted."""
    try:
        out = run_cmd("findmnt -n -o SOURCE /", check=False)
        if not out:
            return None
        # e.g. /dev/vda2 -> /dev/vda
        dev = out.split()[0]
        # Handle partition suffixes like p1 or 1
        base = dev.rstrip("0123456789")
        if base.endswith("p") and base[:-1][-1].isdigit():
            base = base[:-1]
        return base
    except Exception:
        return None


def is_already_installed():
    """
    Check if the current system is running from an installed disk rather than live media.
    Returns True if already installed on disk.
    """
    # 1. Check kernel command-line: live ISO boots with KATUSA_ISO or overlaytmpfs
    try:
        if os.path.exists("/proc/cmdline"):
            with open("/proc/cmdline", "r") as f:
                cmdline = f.read()
            if "KATUSA_ISO" in cmdline or "overlaytmpfs" in cmdline:
                return False
    except Exception:
        pass

    # 2. Check mount points: if /media/root-ro is mounted, we are definitely on live ISO
    if os.path.ismount("/media/root-ro"):
        return False

    # 3. Marker file created during disk installation
    if os.path.exists("/etc/katusa-installed"):
        return True

    # 4. Check root filesystem type from /proc/mounts
    try:
        if os.path.exists("/proc/mounts"):
            with open("/proc/mounts", "r") as f:
                for line in f:
                    parts = line.split()
                    if len(parts) >= 3 and parts[1] == "/":
                        fstype = parts[2]
                        # In live ISO mode, rootfs is overlay/overlayfs
                        if fstype in ["overlay", "overlayfs"]:
                            return False
                        # If rootfs is an actual disk filesystem directly, it's an installed disk
                        if fstype in ["ext4", "ext3", "ext2", "xfs", "btrfs", "f2fs"]:
                            return True
    except Exception:
        pass

    return False


def get_available_disks():
    """Scan and return candidate destination block devices."""
    disks = []
    booted_dev = get_booted_device()

    # Try lsblk first
    if shutil.which("lsblk"):
        try:
            # NAME,SIZE,TYPE,MODEL,RO
            raw = run_cmd("lsblk -d -n -b -o NAME,SIZE,TYPE,MODEL,RO", check=False)
            for line in raw.splitlines():
                parts = line.split(maxsplit=4)
                if len(parts) < 3:
                    continue
                name, size_bytes_str, dev_type = parts[0], parts[1], parts[2]
                model = parts[3] if len(parts) > 3 else "Unknown"
                ro = parts[4] if len(parts) > 4 else "0"

                if dev_type != "disk" or ro == "1":
                    continue
                if name.startswith("loop") or name.startswith("sr") or name.startswith("ram") or name.startswith("zram"):
                    continue

                dev_path = f"/dev/{name}"
                is_booted = (dev_path == booted_dev)
                try:
                    size_gb = round(int(size_bytes_str) / (1024 ** 3), 1)
                except ValueError:
                    size_gb = 0.0

                disks.append({
                    "path": dev_path,
                    "name": name,
                    "size_gb": size_gb,
                    "model": model.strip(),
                    "is_booted": is_booted
                })
            return disks
        except Exception:
            pass

    # Fallback to /sys/block
    if os.path.exists("/sys/block"):
        for name in os.listdir("/sys/block"):
            if name.startswith("loop") or name.startswith("sr") or name.startswith("ram") or name.startswith("zram"):
                continue
            dev_path = f"/dev/{name}"
            size_path = f"/sys/block/{name}/size"
            ro_path = f"/sys/block/{name}/ro"
            model_path = f"/sys/block/{name}/device/model"

            ro = "0"
            if os.path.exists(ro_path):
                with open(ro_path) as f:
                    ro = f.read().strip()
            if ro == "1":
                continue

            size_gb = 0.0
            if os.path.exists(size_path):
                with open(size_path) as f:
                    sectors = int(f.read().strip())
                    size_gb = round((sectors * 512) / (1024 ** 3), 1)

            model = "Block Device"
            if os.path.exists(model_path):
                with open(model_path) as f:
                    model = f.read().strip()

            is_booted = (dev_path == booted_dev)
            disks.append({
                "path": dev_path,
                "name": name,
                "size_gb": size_gb,
                "model": model,
                "is_booted": is_booted
            })

    return disks


def get_partition_names(disk_path):
    """Return ESP and Root partition device paths for a given disk."""
    # /dev/nvme0n1 -> /dev/nvme0n1p1, /dev/nvme0n1p2
    # /dev/vda -> /dev/vda1, /dev/vda2
    if disk_path[-1].isdigit():
        return f"{disk_path}p1", f"{disk_path}p2"
    return f"{disk_path}1", f"{disk_path}2"


def perform_installation(target_disk, hostname="katusaOS", username="katusa", password="katusa", progress_cb=None):
    """
    Executes the full installation pipeline:
    1. Unmount existing partitions
    2. Create GPT partition table (ESP 512MB + Root)
    3. Format partitions (ESP FAT32 + Root ext4)
    4. Mount to /mnt/katusa-install
    5. Copy system files
    6. Configure fstab with UUIDs
    7. Install GRUB UEFI bootloader
    8. Write grub.cfg
    9. Finalize and unmount
    """
    def update(step, total, text):
        if progress_cb:
            progress_cb(step, total, text)
        else:
            print(f"[{step}/{total}] {text}")

    esp_part, root_part = get_partition_names(target_disk)
    mount_dir = "/mnt/katusa-install"
    total_steps = 9

    # Step 1: Unmount target disk
    update(1, total_steps, f"Unmounting active partitions on {target_disk}...")
    run_cmd(f"umount -f {target_disk}* 2>/dev/null || true", check=False)
    run_cmd(f"swapoff {target_disk}* 2>/dev/null || true", check=False)
    run_cmd(f"wipefs -a {target_disk} 2>/dev/null || true", check=False)

    # Step 2: Partition with parted
    update(2, total_steps, f"Creating GPT partition table on {target_disk}...")
    run_cmd(f"parted -s {target_disk} mklabel gpt")
    run_cmd(f"parted -s {target_disk} mkpart ESP fat32 1MiB 513MiB")
    run_cmd(f"parted -s {target_disk} set 1 esp on")
    run_cmd(f"parted -s {target_disk} mkpart root ext4 513MiB 100%")
    run_cmd(f"partprobe {target_disk} 2>/dev/null || true", check=False)
    run_cmd("mdev -s 2>/dev/null || true", check=False)
    time.sleep(1)
    if not os.path.exists(esp_part) or not os.path.exists(root_part):
        run_cmd("mdev -s 2>/dev/null || true", check=False)
        time.sleep(1)

    # Step 3: Format partitions
    update(3, total_steps, f"Formatting ESP ({esp_part}) and Root ({root_part})...")
    run_cmd(f"mkfs.vfat -F32 -n 'KATUSA-ESP' {esp_part}")
    run_cmd(f"mkfs.ext4 -F -L 'katusa-root' {root_part}")

    # Step 4: Mount target partitions
    update(4, total_steps, "Mounting target filesystems...")
    os.makedirs(f"{mount_dir}/boot/efi", exist_ok=True)
    run_cmd(f"mount {root_part} {mount_dir}")
    os.makedirs(f"{mount_dir}/boot/efi", exist_ok=True)
    run_cmd(f"mount {esp_part} {mount_dir}/boot/efi")

    # Step 5: Copy system files
    update(5, total_steps, "Copying katusaOS system files and toolchains (this may take a minute)...")
    excludes = [
        "--exclude=/proc/*",
        "--exclude=/sys/*",
        "--exclude=/dev/*",
        "--exclude=/run/*",
        "--exclude=/mnt/*",
        "--exclude=/tmp/*",
        "--exclude=/media/*",
        "--exclude=/lost+found"
    ]
    exclude_str = " ".join(excludes)
    run_cmd(f"rsync -aHAX {exclude_str} / {mount_dir}/")

    for d in ["proc", "sys", "dev", "run", "mnt", "tmp", "media"]:
        os.makedirs(f"{mount_dir}/{d}", exist_ok=True)
    os.chmod(f"{mount_dir}/tmp", 0o1777)

    # Step 6: Generate /etc/fstab with UUIDs
    update(6, total_steps, "Configuring filesystem table (/etc/fstab)...")
    root_uuid = run_cmd(f"blkid -s UUID -o value {root_part}", check=False)
    esp_uuid = run_cmd(f"blkid -s UUID -o value {esp_part}", check=False)

    fstab_content = (
        "# /etc/fstab: static file system information for katusaOS\n"
        f"UUID={root_uuid}   /          ext4    noatime,rw   0   1\n"
        f"UUID={esp_uuid}    /boot/efi  vfat    umask=0077   0   2\n"
        "tmpfs              /tmp       tmpfs   defaults     0   0\n"
    )
    with open(f"{mount_dir}/etc/fstab", "w") as f:
        f.write(fstab_content)

    # Step 7: Install GRUB UEFI bootloader
    update(7, total_steps, "Installing GRUB UEFI bootloader to ESP...")
    arch = run_cmd("uname -m", check=False)
    grub_target = "arm64-efi" if arch in ["aarch64", "arm64"] else "x86_64-efi"

    run_cmd(
        f"grub-install --target={grub_target} "
        f"--efi-directory={mount_dir}/boot/efi "
        f"--boot-directory={mount_dir}/boot "
        f"--bootloader-id=katusaOS "
        f"--removable --recheck",
        check=False
    )

    # Step 8: Configure grub.cfg and host settings
    update(8, total_steps, "Generating GRUB configuration and finalizing system...")
    os.makedirs(f"{mount_dir}/boot/grub", exist_ok=True)
    console_param = "console=tty0 console=ttyAMA0" if arch in ["aarch64", "arm64"] else "console=tty0 console=ttyS0"
    grub_cfg = f"""# GRUB Configuration for katusaOS
set default=0
set timeout=3

insmod part_gpt
insmod ext2
insmod fat
insmod all_video

menuentry 'katusaOS' {{
    search --no-floppy --fs-uuid --set=root {root_uuid}
    linux /boot/vmlinuz-virt root=UUID={root_uuid} rw modules=ext4,virtio_pci,virtio_blk,virtio_gpu {console_param} quiet
    initrd /boot/initramfs-virt
}}

menuentry 'katusaOS (Fallback Recovery)' {{
    search --no-floppy --fs-uuid --set=root {root_uuid}
    linux /boot/vmlinuz-virt root=UUID={root_uuid} rw modules=ext4,virtio_pci,virtio_blk,virtio_gpu {console_param} single
    initrd /boot/initramfs-virt
}}
"""
    with open(f"{mount_dir}/boot/grub/grub.cfg", "w") as f:
        f.write(grub_cfg)

    # Also write to ESP partition for maximum UEFI compatibility
    os.makedirs(f"{mount_dir}/boot/efi/EFI/BOOT", exist_ok=True)
    os.makedirs(f"{mount_dir}/boot/efi/boot/grub", exist_ok=True)
    with open(f"{mount_dir}/boot/efi/EFI/BOOT/grub.cfg", "w") as f:
        f.write(grub_cfg)
    with open(f"{mount_dir}/boot/efi/boot/grub/grub.cfg", "w") as f:
        f.write(grub_cfg)

    # Write hostname
    with open(f"{mount_dir}/etc/hostname", "w") as f:
        f.write(f"{hostname}\n")

    # Mark system as permanently installed to disk
    with open(f"{mount_dir}/etc/katusa-installed", "w") as f:
        f.write(f"INSTALLED_DATE={time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime())}\n")
        f.write(f"TARGET_DISK={target_disk}\n")
        f.write(f"ROOT_UUID={root_uuid}\n")

    # Clean login issue banner and MOTD on target disk (remove installer prompt & default credentials)
    for issue_file in [f"{mount_dir}/etc/issue", f"{mount_dir}/etc/issue.net"]:
        if os.path.exists(issue_file):
            try:
                with open(issue_file, "r") as f:
                    issue_lines = f.readlines()
                filtered = [
                    line for line in issue_lines
                    if "katusa-install" not in line
                    and "Default User" not in line
                    and "Password" not in line
                ]
                content = "".join(filtered).strip() + "\n\n"
                with open(issue_file, "w") as f:
                    f.write(content)
            except Exception:
                pass

    motd_file = f"{mount_dir}/etc/motd"
    if os.path.exists(motd_file):
        try:
            with open(motd_file, "r") as f:
                motd_lines = f.readlines()
            filtered_motd = [
                l for l in motd_lines
                if "katusa-install" not in l
                and "install katusaOS permanently" not in l
                and "Default User" not in l
                and "Password" not in l
            ]
            with open(motd_file, "w") as f:
                f.writelines(filtered_motd)
        except Exception:
            pass

    # Step 9: Sync and unmount
    update(9, total_steps, "Syncing disk buffers and unmounting target...")
    run_cmd("sync")
    run_cmd(f"umount -R {mount_dir} 2>/dev/null || true", check=False)
    time.sleep(1)


