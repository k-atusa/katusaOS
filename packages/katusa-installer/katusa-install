    # Screen 2c: Desktop Environment Selection
    desktop_idx = 0
    if initial_desktop:
        for idx, de in enumerate(SUPPORTED_DESKTOPS):
            if de["id"] == initial_desktop.lower():
                desktop_idx = idx
                break

    selected_desktop = SUPPORTED_DESKTOPS[desktop_idx]["id"]
    while True:
        stdscr.clear()
        h, w = stdscr.getmaxyx()

        title = "★ Step 3: Select Desktop Environment ★"
        safe_addstr(2, max(0, (w - len(title)) // 2), title, curses.color_pair(1) | curses.A_BOLD)
        desc = "Choose a graphical desktop environment, or Console for minimal CLI."
        safe_addstr(4, max(0, (w - len(desc)) // 2), desc, curses.A_DIM)

        start_y = 6
        for i, de in enumerate(SUPPORTED_DESKTOPS):
            prefix = "  [>] " if i == desktop_idx else "      "
            tag = f"  [{de['tag']}]" if de.get("tag") else ""
            line = f"{prefix}{de['name']:<24}{tag}"
            attr = curses.color_pair(2) if i == desktop_idx else curses.A_NORMAL
            safe_addstr(start_y + i * 3, max(4, (w - 74) // 2), line, attr)
            safe_addstr(start_y + i * 3 + 1, max(4, (w - 74) // 2) + 6, de["desc"], curses.A_DIM)

        warn_net = "Note: Installing a GUI Desktop requires an active internet connection."
        safe_addstr(h - 3, max(0, (w - len(warn_net)) // 2), warn_net, curses.color_pair(5))

        hint = "Enter: Select Desktop  |  UP/DOWN: Navigate  |  q: Cancel & Exit"
        safe_addstr(h - 2, max(0, (w - len(hint)) // 2), hint, curses.A_DIM)
        stdscr.refresh()

        key = stdscr.getch()
        if key in [curses.KEY_UP, ord('k')]:
