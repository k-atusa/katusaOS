def run_curses_gui(stdscr):
    import curses

    def safe_curs_set(vis):
        """Safely set cursor state without failing on terminals that lack civis/cnorm."""
        try:
            curses.curs_set(vis)
        except Exception:
            pass

    def safe_addstr(y, x, text, attr=curses.A_NORMAL):
        """Safely draw text within terminal bounds without triggering curses ERR."""
        try:
            cur_h, cur_w = stdscr.getmaxyx()
            if 0 <= y < cur_h and 0 <= x < cur_w:
                # Leave 1 column free on the very last line to prevent scroll/ERR
                max_len = cur_w - x - (1 if y == cur_h - 1 else 0)
                if max_len > 0:
                    stdscr.addstr(y, x, text[:max_len], attr)
        except Exception:
            pass

    # Setup colors and cursor
    safe_curs_set(0)
    if curses.has_colors():
        try:
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
            curses.init_pair(3, curses.COLOR_RED, -1)
            curses.init_pair(4, curses.COLOR_GREEN, -1)
            curses.init_pair(5, curses.COLOR_YELLOW, -1)
        except Exception:
            pass

    # Screen 1: Welcome
    while True:
        stdscr.clear()
        h, w = stdscr.getmaxyx()

        # Title
        title_line1 = "katusaOS Disk Installer"
        title_line2 = "★ Katusa Programming Club Dedicated Operating System ★"
        start_y = max(2, (h - 16) // 2)
        safe_addstr(start_y, max(0, (w - len(title_line1)) // 2), title_line1, curses.color_pair(1) | curses.A_BOLD)
        safe_addstr(start_y + 1, max(0, (w - len(title_line2)) // 2), title_line2, curses.color_pair(3) | curses.A_BOLD)

        intro_y = start_y + 4
        safe_addstr(intro_y, max(0, (w - 44) // 2), "Welcome to the katusaOS Disk Installer!", curses.A_BOLD)
        safe_addstr(intro_y + 1, max(0, (w - 62) // 2), "Install katusaOS permanently to your UTM virtual disk or drive.", curses.color_pair(5))

        btn = "[ Press ENTER to Begin Installation ]"
        safe_addstr(intro_y + 4, max(0, (w - len(btn)) // 2), btn, curses.color_pair(2) | curses.A_BOLD)

        quit_hint = "Press 'q' or 'ESC' to exit to shell"
        safe_addstr(intro_y + 6, max(0, (w - len(quit_hint)) // 2), quit_hint, curses.A_DIM)

        stdscr.refresh()
        key = stdscr.getch()
        if key in [10, 13]: # Enter
            break
        elif key in [ord('q'), ord('Q'), 27]: # q or ESC
            return False

    # Screen 2: Disk Selection
    disks = get_available_disks()
    if not disks:
        stdscr.clear()
        h, w = stdscr.getmaxyx()
        msg = "No suitable target disks detected!"
        hint = "Ensure a virtual drive is attached in UTM (e.g. VirtIO 20GB+)."
        safe_addstr(h // 2 - 1, max(0, (w - len(msg)) // 2), msg, curses.color_pair(3) | curses.A_BOLD)
        safe_addstr(h // 2 + 1, max(0, (w - len(hint)) // 2), hint)
        safe_addstr(h // 2 + 3, max(0, (w - 24) // 2), "Press any key to exit...", curses.A_DIM)
        stdscr.refresh()
        stdscr.getch()
        return False

    selected_idx = 0
    while True:
        stdscr.clear()
        h, w = stdscr.getmaxyx()

        title = "★ Step 1: Select Target Disk for Installation ★"
        safe_addstr(2, max(0, (w - len(title)) // 2), title, curses.color_pair(1) | curses.A_BOLD)
        desc = "Use UP/DOWN arrows to choose disk, then press ENTER to select."
        safe_addstr(4, max(0, (w - len(desc)) // 2), desc, curses.A_DIM)

        start_y = 6
        for i, d in enumerate(disks):
            prefix = "  [>] " if i == selected_idx else "      "
            boot_tag = " (Current Live Disk - CAUTION)" if d["is_booted"] else ""
            line = f"{prefix}{d['path']:<12} {d['size_gb']:>6.1f} GiB  |  {d['model']}{boot_tag}"
            attr = curses.color_pair(2) | curses.A_BOLD if i == selected_idx else curses.A_NORMAL
            if d["is_booted"]:
                attr |= curses.color_pair(3)
            safe_addstr(start_y + i * 2, max(4, (w - 70) // 2), line, attr)

        hint = "Enter: Select Disk  |  q: Cancel & Exit"
        safe_addstr(h - 2, max(0, (w - len(hint)) // 2), hint, curses.A_DIM)
        stdscr.refresh()

        key = stdscr.getch()
        if key in [curses.KEY_UP, ord('k')]:
            selected_idx = (selected_idx - 1) % len(disks)
        elif key in [curses.KEY_DOWN, ord('j')]:
            selected_idx = (selected_idx + 1) % len(disks)
        elif key in [10, 13]: # Enter
            target_disk = disks[selected_idx]
            break
        elif key in [ord('q'), 27]:
            return False

    # Screen 3: Confirmation Dialog
    stdscr.clear()
    h, w = stdscr.getmaxyx()

    box_w = 64
    box_h = 14
    box_x = max(0, (w - box_w) // 2)
    box_y = max(0, (h - box_h) // 2)

    warn_title = "⚠ WARNING: DATA DESTRUCTION CONFIRMATION ⚠"
    warn_text1 = f"All data on {target_disk['path']} ({target_disk['size_gb']} GiB) will be PERMANENTLY ERASED!"
    warn_text2 = "A new GPT partition table, EFI ESP, and rootfs will be created."
    prompt = "Type 'YES' to proceed with installation, or 'NO' to abort:"

    safe_addstr(box_y, max(0, (w - len(warn_title)) // 2), warn_title, curses.color_pair(3) | curses.A_BOLD)
    safe_addstr(box_y + 2, box_x + 2, warn_text1, curses.A_BOLD)
    safe_addstr(box_y + 4, box_x + 2, warn_text2, curses.color_pair(5))
    safe_addstr(box_y + 6, box_x + 2, prompt, curses.A_BOLD)

    # Input prompt
    try:
        curses.echo()
        safe_curs_set(1)
        safe_addstr(box_y + 8, box_x + 2, "Confirmation: ")
        stdscr.refresh()
        input_x = min(box_x + 16, max(0, w - 12))
        user_input = stdscr.getstr(box_y + 8, input_x, 10).decode("utf-8", errors="ignore").strip()
    finally:
        curses.noecho()
        safe_curs_set(0)

    if user_input.upper() != "YES":
        stdscr.clear()
        safe_addstr(h // 2, max(0, (w - 30) // 2), "Installation aborted by user.", curses.color_pair(3))
        stdscr.refresh()
        time.sleep(1.5)
        return False

    # Screen 4: Progress Execution
    stdscr.clear()
    title = "★ Installing katusaOS to Target Disk ★"
    safe_addstr(2, max(0, (w - len(title)) // 2), title, curses.color_pair(1) | curses.A_BOLD)
    stdscr.refresh()

    steps_log = []
    def progress_callback(step, total, text):
        stdscr.clear()
        safe_addstr(2, max(0, (w - len(title)) // 2), title, curses.color_pair(1) | curses.A_BOLD)

        # Progress bar
        percent = int((step / total) * 100)
        bar_len = 40
        filled = int((percent / 100) * bar_len)
        bar_str = f"[{'█' * filled}{'░' * (bar_len - filled)}] {percent}%"
        safe_addstr(4, max(0, (w - len(bar_str)) // 2), bar_str, curses.color_pair(1) | curses.A_BOLD)

        # Steps list
        steps_log.append((step, text))
        start_y = 7
        for s_idx, (s_num, s_text) in enumerate(steps_log[-8:]):
            if s_num == step:
                prefix = "  [▶] "
                attr = curses.color_pair(5) | curses.A_BOLD
            else:
                prefix = "  [✔] "
                attr = curses.color_pair(4)
            safe_addstr(start_y + s_idx, max(4, (w - 60) // 2), f"{prefix}{s_text}", attr)

        stdscr.refresh()

    try:
        perform_installation(target_disk["path"], progress_cb=progress_callback)
    except Exception as e:
        stdscr.clear()
        err = f"Installation Failed: {str(e)}"
        safe_addstr(h // 2 - 1, max(0, (w - len(err)) // 2), err, curses.color_pair(3) | curses.A_BOLD)
        safe_addstr(h // 2 + 2, max(0, (w - 24) // 2), "Press any key to exit...", curses.A_DIM)
        stdscr.refresh()
        stdscr.getch()
        return False

    # Screen 5: Success
    stdscr.clear()
    h, w = stdscr.getmaxyx()
    succ_title = "🎉 katusaOS Installation Complete! 🎉"
    safe_addstr(h // 2 - 4, max(0, (w - len(succ_title)) // 2), succ_title, curses.color_pair(4) | curses.A_BOLD)

    info1 = f"katusaOS has been installed successfully onto {target_disk['path']}."
    info2 = "Next steps for UTM App users:"
    info3 = "1. In UTM VM Settings, detach/remove the installer ISO or drive."
    info4 = "2. Reboot the virtual machine to boot directly from your new disk!"

    safe_addstr(h // 2 - 2, max(0, (w - len(info1)) // 2), info1)
    safe_addstr(h // 2, max(0, (w - len(info2)) // 2), info2, curses.color_pair(1))
    safe_addstr(h // 2 + 1, max(0, (w - len(info3)) // 2), info3)
    safe_addstr(h // 2 + 2, max(0, (w - len(info4)) // 2), info4)

    btn = "[ Press ENTER to Reboot Now  |  Press 'q' for Terminal ]"
    safe_addstr(h // 2 + 5, max(0, (w - len(btn)) // 2), btn, curses.color_pair(2) | curses.A_BOLD)
    stdscr.refresh()

    while True:
        key = stdscr.getch()
        if key in [10, 13]:
            return "reboot"
        elif key in [ord('q'), 27]:
            return "quit"

    return "quit"


