        key = stdscr.getch()
        if key in [curses.KEY_UP, ord('k')]:
            mode_idx = (mode_idx - 1) % len(boot_modes)
        elif key in [curses.KEY_DOWN, ord('j')]:
            mode_idx = (mode_idx + 1) % len(boot_modes)
        elif key in [10, 13]: # Enter
            selected_boot_mode = boot_modes[mode_idx]["id"]
            break
        elif key in [ord('q'), 27]:
