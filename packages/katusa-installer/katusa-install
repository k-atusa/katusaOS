    box_w = 70
    box_h = 18
    box_x = max(0, (w - box_w) // 2)
    box_y = max(0, (h - box_h) // 2)

    mode_label = "GPT (UEFI)" if selected_boot_mode == "gpt" else "MBR (Legacy BIOS)"
    warn_title = "⚠ WARNING: DATA DESTRUCTION CONFIRMATION ⚠"
    warn_text1 = f"Target: {target_disk['path']} ({target_disk['size_gb']} GiB)  |  Scheme: {mode_label}"
    warn_text2 = f"Desktop Environment: {desktop_label}"
    warn_text3 = f"All data on {target_disk['path']} will be PERMANENTLY ERASED!"
    warn_text4 = f"A fresh {selected_boot_mode.upper()} partition layout and katusaOS will be installed."
    prompt = "Type 'YES' to proceed with installation, or 'NO' to abort:"

    safe_addstr(box_y, max(0, (w - len(warn_title)) // 2), warn_title, curses.color_pair(3) | curses.A_BOLD)
