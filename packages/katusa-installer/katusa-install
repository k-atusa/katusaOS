def check_network_connectivity(timeout=3):
    """Check if internet connectivity is available for downloading packages."""
    # 1. Try resolving Alpine Linux mirror host
    try:
        import socket
        socket.setdefaulttimeout(timeout)
        socket.gethostbyname("dl-cdn.alpinelinux.org")
        return True
    except Exception:
        pass

    # 2. Fallback to pinging DNS servers (1.1.1.1 or 8.8.8.8)
    for dns_ip in ["1.1.1.1", "8.8.8.8"]:
        try:
            res = subprocess.run(
                ["ping", "-c", "1", "-W", str(timeout), dns_ip],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            if res.returncode == 0:
                return True
        except Exception:
            pass

    return False


def _install_desktop_packages_fallback(mount_dir, desktop, username, progress_update=None):
    """Fallback installation of desktop packages and OpenRC services directly via APK."""
    profiles = {
        "xfce": {
            "packages": "xorg-server xf86-input-libinput xinit eudev mesa-dri-gallium xfce4 xfce4-terminal xfce4-screensaver lightdm lightdm-gtk-greeter elogind polkit-elogind gvfs font-dejavu dbus dbus-x11",
            "services": ["udev", "udev-trigger", "udev-settle", "dbus", "elogind", "lightdm"]
        },
        "gnome": {
            "packages": "elogind polkit-elogind eudev mesa-dri-gallium gnome gnome-apps-core gdm dbus font-dejavu",
            "services": ["udev", "udev-trigger", "udev-settle", "dbus", "elogind", "gdm"]
        },
        "plasma": {
            "packages": "elogind polkit-elogind eudev mesa-dri-gallium plasma-desktop-meta kde-applications-base sddm dbus font-dejavu",
            "services": ["udev", "udev-trigger", "udev-settle", "dbus", "elogind", "sddm"]
        },
        "sway": {
            "packages": "elogind polkit-elogind eudev mesa-dri-gallium sway swaybg swayidle swaylockd foot wmenu xwayland seatd font-dejavu",
            "services": ["udev", "udev-trigger", "udev-settle", "dbus", "elogind", "seatd"]
        },
        "lxqt": {
            "packages": "xorg-server xf86-input-libinput xinit eudev mesa-dri-gallium lxqt-desktop sddm openbox elogind polkit-elogind gvfs udisks2 font-dejavu dbus dbus-x11",
            "services": ["udev", "udev-trigger", "udev-settle", "dbus", "elogind", "sddm"]
        }
    }
    cfg = profiles.get(desktop)
    if not cfg:
        return

    if progress_update:
        progress_update(f"Downloading & installing {desktop.upper()} packages via APK...")
    run_cmd(f"chroot {mount_dir} apk add --no-cache {cfg['packages']}")

    if progress_update:
        progress_update("Enabling display manager and hardware OpenRC services...")
    for svc in cfg["services"]:
        run_cmd(f"chroot {mount_dir} rc-update add {svc} default 2>/dev/null || true", check=False)


def install_desktop_environment(mount_dir, desktop, username="katusa", progress_update=None):
    """
    Installs and configures the selected Desktop Environment on the target root filesystem.
    """
    if not desktop or desktop.lower() == "none":
        return

    desktop = desktop.lower()
    valid_ids = [d["id"] for d in SUPPORTED_DESKTOPS if d["id"] != "none"]
    if desktop not in valid_ids:
        raise ValueError(f"Unsupported desktop environment: {desktop}")

    if progress_update:
        progress_update(f"Checking internet connectivity for {desktop.upper()} packages...")

    if not check_network_connectivity():
        raise RuntimeError(
            f"Internet connectivity is required to download and install {desktop.upper()} packages, "
            "but no active network connection was detected. Please connect your network interface or select 'none' (Console only)."
        )

    if progress_update:
        progress_update("Mounting virtual filesystems for chroot environment...")

    # Bind mount virtual filesystems
    run_cmd(f"mount -t proc /proc {mount_dir}/proc 2>/dev/null || true", check=False)
    run_cmd(f"mount -t sysfs /sys {mount_dir}/sys 2>/dev/null || true", check=False)
    run_cmd(f"mount --bind /dev {mount_dir}/dev 2>/dev/null || true", check=False)
    run_cmd(f"mount --bind /dev/pts {mount_dir}/dev/pts 2>/dev/null || true", check=False)

    # Ensure resolv.conf is copied for DNS resolution
    if os.path.exists("/etc/resolv.conf"):
        try:
            shutil.copyfile("/etc/resolv.conf", f"{mount_dir}/etc/resolv.conf")
        except Exception:
            pass
    if not os.path.exists(f"{mount_dir}/etc/resolv.conf") or os.path.getsize(f"{mount_dir}/etc/resolv.conf") == 0:
        with open(f"{mount_dir}/etc/resolv.conf", "w") as f:
            f.write("nameserver 1.1.1.1\nnameserver 8.8.8.8\n")

    try:
        if progress_update:
            progress_update("Updating APK repository package index...")
        run_cmd(f"chroot {mount_dir} apk update", check=False)

        has_setup_desktop = (
            os.path.exists(f"{mount_dir}/sbin/setup-desktop") or
            os.path.exists(f"{mount_dir}/usr/sbin/setup-desktop")
        )

        if has_setup_desktop:
            if progress_update:
                progress_update(f"Running setup-desktop {desktop} (this may take a few minutes)...")
            res = subprocess.run(
                f"chroot {mount_dir} /bin/sh -c 'setup-desktop {desktop}'",
                shell=True,
                text=True,
                capture_output=True
            )
            if res.returncode != 0:
                if progress_update:
                    progress_update(f"setup-desktop returned warning, installing profile packages directly...")
                _install_desktop_packages_fallback(mount_dir, desktop, username, progress_update)
        else:
            _install_desktop_packages_fallback(mount_dir, desktop, username, progress_update)

        # Ensure user belongs to audio, video, input, seat, netdev groups
        if progress_update:
            progress_update(f"Configuring graphical user permissions for '{username}'...")
        user_groups = ["audio", "video", "input", "seat", "netdev"]
        for grp in user_groups:
            run_cmd(f"chroot {mount_dir} addgroup {username} {grp} 2>/dev/null || true", check=False)

        # Set GTK dark theme preference
        gtk_settings_dir = f"{mount_dir}/etc/gtk-3.0"
        os.makedirs(gtk_settings_dir, exist_ok=True)
        gtk_settings_file = f"{gtk_settings_dir}/settings.ini"
        if not os.path.exists(gtk_settings_file):
            with open(gtk_settings_file, "w") as f:
                f.write("[Settings]\ngtk-application-prefer-dark-theme=1\n")

    finally:
        # Cleanly unmount chroot filesystems
        run_cmd(f"umount -l {mount_dir}/proc 2>/dev/null || true", check=False)
        run_cmd(f"umount -l {mount_dir}/sys 2>/dev/null || true", check=False)
        run_cmd(f"umount -l {mount_dir}/dev/pts 2>/dev/null || true", check=False)
        run_cmd(f"umount -l {mount_dir}/dev 2>/dev/null || true", check=False)


def perform_installation(target_disk, boot_mode="gpt", desktop="none", hostname="katusaOS", username="katusa", password="katusa", progress_cb=None):
    """
    Executes the full installation pipeline:
    1. Unmount existing partitions
    2. Create partition table (GPT for UEFI or MBR/msdos for Legacy BIOS)
    3. Format partitions (Root ext4, and ESP FAT32 if GPT)
    4. Mount to /mnt/katusa-install
    5. Copy system files
    6. Configure fstab with UUIDs
    7. Install GRUB bootloader (UEFI or Legacy BIOS)
    8. Write grub.cfg and host configuration
    9. Install selected Desktop Environment (if specified)
    10. Finalize and unmount
    """
    boot_mode = (boot_mode or "gpt").lower()
    if boot_mode not in ["gpt", "mbr"]:
        boot_mode = "gpt"
    desktop = (desktop or "none").lower()

    def update(step, total, text):
        if progress_cb:
            progress_cb(step, total, text)
        else:
            print(f"[{step}/{total}] {text}")

    esp_part, root_part = get_partition_names(target_disk, boot_mode)
    mount_dir = "/mnt/katusa-install"
    total_steps = 10

    # Step 1: Unmount target disk
    update(1, total_steps, f"Unmounting active partitions on {target_disk}...")
    run_cmd(f"umount -f {target_disk}* 2>/dev/null || true", check=False)
    run_cmd(f"swapoff {target_disk}* 2>/dev/null || true", check=False)
    run_cmd(f"wipefs -a {target_disk} 2>/dev/null || true", check=False)

    # Step 2: Partition with parted
    if boot_mode == "mbr":
        update(2, total_steps, f"Creating MBR (msdos) partition table on {target_disk}...")
        run_cmd(f"parted -s {target_disk} mklabel msdos")
        run_cmd(f"parted -s {target_disk} mkpart primary ext4 1MiB 100%")
        run_cmd(f"parted -s {target_disk} set 1 boot on")
        run_cmd(f"partprobe {target_disk} 2>/dev/null || true", check=False)
        run_cmd("mdev -s 2>/dev/null || true", check=False)
        time.sleep(1)
        if not os.path.exists(root_part):
            run_cmd("mdev -s 2>/dev/null || true", check=False)
            time.sleep(1)
    else:
        update(2, total_steps, f"Creating GPT partition table on {target_disk}...")
        run_cmd(f"parted -s {target_disk} mklabel gpt")
        run_cmd(f"parted -s {target_disk} mkpart ESP fat32 1MiB 513MiB")
        run_cmd(f"parted -s {target_disk} set 1 esp on")
        run_cmd(f"parted -s {target_disk} mkpart root ext4 513MiB 100%")
        run_cmd(f"partprobe {target_disk} 2>/dev/null || true", check=False)
        run_cmd("mdev -s 2>/dev/null || true", check=False)
        time.sleep(1)
        if not os.path.exists(esp_part) or not os.path.exists(root_part):
            run_cmd("mdev -s 2>/dev/null || true", check=False)
            time.sleep(1)

    # Step 3: Format partitions
    if boot_mode == "mbr":
        update(3, total_steps, f"Formatting Root partition ({root_part})...")
        run_cmd(f"mkfs.ext4 -F -L 'katusa-root' {root_part}")
    else:
        update(3, total_steps, f"Formatting ESP ({esp_part}) and Root ({root_part})...")
        run_cmd(f"mkfs.vfat -F32 -n 'KATUSA-ESP' {esp_part}")
        run_cmd(f"mkfs.ext4 -F -L 'katusa-root' {root_part}")

    # Step 4: Mount target partitions
    update(4, total_steps, "Mounting target filesystems...")
    os.makedirs(mount_dir, exist_ok=True)
    run_cmd(f"mount {root_part} {mount_dir}")
    if boot_mode == "gpt":
        os.makedirs(f"{mount_dir}/boot/efi", exist_ok=True)
        run_cmd(f"mount {esp_part} {mount_dir}/boot/efi")

    # Step 5: Copy system files
    update(5, total_steps, "Copying katusaOS system files and toolchains (this may take a minute)...")
    excludes = [
        "--exclude=/proc/*",
        "--exclude=/sys/*",
        "--exclude=/dev/*",
        "--exclude=/run/*",
        "--exclude=/mnt/*",
        "--exclude=/tmp/*",
        "--exclude=/media/*",
        "--exclude=/lost+found"
    ]
    exclude_str = " ".join(excludes)
    run_cmd(f"rsync -aHAX {exclude_str} / {mount_dir}/")

    for d in ["proc", "sys", "dev", "run", "mnt", "tmp", "media"]:
        os.makedirs(f"{mount_dir}/{d}", exist_ok=True)
    os.chmod(f"{mount_dir}/tmp", 0o1777)

    # Step 6: Generate /etc/fstab with UUIDs
    update(6, total_steps, "Configuring filesystem table (/etc/fstab)...")
    root_uuid = run_cmd(f"blkid -s UUID -o value {root_part}", check=False)

    if boot_mode == "mbr":
        fstab_content = (
            "# /etc/fstab: static file system information for katusaOS (MBR Legacy BIOS)\n"
            f"UUID={root_uuid}   /          ext4    noatime,rw   0   1\n"
            "tmpfs              /tmp       tmpfs   defaults     0   0\n"
        )
    else:
        esp_uuid = run_cmd(f"blkid -s UUID -o value {esp_part}", check=False)
        fstab_content = (
            "# /etc/fstab: static file system information for katusaOS (GPT UEFI)\n"
            f"UUID={root_uuid}   /          ext4    noatime,rw   0   1\n"
            f"UUID={esp_uuid}    /boot/efi  vfat    umask=0077   0   2\n"
            "tmpfs              /tmp       tmpfs   defaults     0   0\n"
        )
    with open(f"{mount_dir}/etc/fstab", "w") as f:
        f.write(fstab_content)

    # Step 7: Install GRUB bootloader
    arch = run_cmd("uname -m", check=False)
    if boot_mode == "mbr":
        update(7, total_steps, f"Installing GRUB Legacy BIOS (MBR) bootloader to {target_disk}...")
        if arch in ["aarch64", "arm64"]:
            run_cmd(
                f"grub-install --target=arm64-efi "
                f"--boot-directory={mount_dir}/boot "
                f"--bootloader-id=katusaOS "
                f"--removable --recheck",
                check=False
            )
        else:
            run_cmd(
                f"grub-install --target=i386-pc "
                f"--boot-directory={mount_dir}/boot "
                f"--recheck {target_disk}",
                check=False
            )
    else:
        update(7, total_steps, "Installing GRUB UEFI bootloader to ESP...")
        grub_target = "arm64-efi" if arch in ["aarch64", "arm64"] else "x86_64-efi"
        run_cmd(
            f"grub-install --target={grub_target} "
            f"--efi-directory={mount_dir}/boot/efi "
            f"--boot-directory={mount_dir}/boot "
            f"--bootloader-id=katusaOS "
            f"--removable --recheck",
            check=False
        )

    # Step 8: Configure grub.cfg and host settings
    update(8, total_steps, "Generating GRUB configuration and finalizing system...")
    os.makedirs(f"{mount_dir}/boot/grub", exist_ok=True)
    console_param = "console=tty0 console=ttyAMA0" if arch in ["aarch64", "arm64"] else "console=tty0 console=ttyS0"
    grub_cfg = f"""# GRUB Configuration for katusaOS
set default=0
set timeout=3

insmod part_gpt
insmod part_msdos
insmod ext2
insmod fat
insmod all_video

menuentry 'katusaOS' {{
    search --no-floppy --fs-uuid --set=root {root_uuid}
    linux /boot/vmlinuz-virt root=UUID={root_uuid} rw modules=ext4,virtio_pci,virtio_blk,virtio_gpu {console_param} quiet
    initrd /boot/initramfs-virt
}}

menuentry 'katusaOS (Fallback Recovery)' {{
    search --no-floppy --fs-uuid --set=root {root_uuid}
    linux /boot/vmlinuz-virt root=UUID={root_uuid} rw modules=ext4,virtio_pci,virtio_blk,virtio_gpu {console_param} single
    initrd /boot/initramfs-virt
}}
"""
    with open(f"{mount_dir}/boot/grub/grub.cfg", "w") as f:
        f.write(grub_cfg)

    if boot_mode == "gpt":
        # Also write to ESP partition for maximum UEFI compatibility
        os.makedirs(f"{mount_dir}/boot/efi/EFI/BOOT", exist_ok=True)
        os.makedirs(f"{mount_dir}/boot/efi/boot/grub", exist_ok=True)
        with open(f"{mount_dir}/boot/efi/EFI/BOOT/grub.cfg", "w") as f:
            f.write(grub_cfg)
        with open(f"{mount_dir}/boot/efi/boot/grub/grub.cfg", "w") as f:
            f.write(grub_cfg)

    # Write hostname
    with open(f"{mount_dir}/etc/hostname", "w") as f:
        f.write(f"{hostname}\n")

    # Mark system as permanently installed to disk
    with open(f"{mount_dir}/etc/katusa-installed", "w") as f:
        f.write(f"INSTALLED_DATE={time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime())}\n")
        f.write(f"TARGET_DISK={target_disk}\n")
        f.write(f"BOOT_MODE={boot_mode.upper()}\n")
        f.write(f"DESKTOP_ENVIRONMENT={(desktop or 'none').upper()}\n")
        f.write(f"ROOT_UUID={root_uuid}\n")

    # Clean login issue banner and MOTD on target disk (remove installer prompt & default credentials)
    for issue_file in [f"{mount_dir}/etc/issue", f"{mount_dir}/etc/issue.net"]:
        if os.path.exists(issue_file):
            try:
                with open(issue_file, "r") as f:
                    issue_lines = f.readlines()
                filtered = [
                    line for line in issue_lines
                    if "katusa-install" not in line
                    and "Default User" not in line
                    and "Password" not in line
                ]
                content = "".join(filtered).strip() + "\n\n"
                with open(issue_file, "w") as f:
                    f.write(content)
            except Exception:
                pass

    motd_file = f"{mount_dir}/etc/motd"
    if os.path.exists(motd_file):
        try:
            with open(motd_file, "r") as f:
                motd_lines = f.readlines()
            filtered_motd = [
                l for l in motd_lines
                if "katusa-install" not in l
                and "install katusaOS permanently" not in l
                and "Default User" not in l
                and "Password" not in l
            ]
            with open(motd_file, "w") as f:
                f.writelines(filtered_motd)
        except Exception:
            pass

    # Step 9: Configure Desktop Environment
    if desktop != "none":
        update(9, total_steps, f"Installing & configuring {desktop.upper()} Desktop Environment...")
        install_desktop_environment(
            mount_dir,
            desktop=desktop,
            username=username,
            progress_update=lambda msg: update(9, total_steps, msg)
        )
    else:
        update(9, total_steps, "Configuring console environment (Skipping GUI Desktop)...")

    # Step 10: Sync and unmount
    update(10, total_steps, "Syncing disk buffers and unmounting target...")
    run_cmd("sync")
    run_cmd(f"umount -R {mount_dir} 2>/dev/null || true", check=False)
    time.sleep(1)


