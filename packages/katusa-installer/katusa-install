    info1_de = f"Installed Desktop: {desktop_label}"
    info2 = "Next steps before rebooting:"
    info3 = "• VM Environment: Detach installer ISO from VM settings, then reboot."
    info4 = "• USB Boot / PC : Detach installation media (USB drive), then reboot."
    info5 = "• Default user credentials: 'katusa' / password 'katusa'"
    if selected_desktop != "none":
        info6 = "• Graphical desktop will launch automatically upon login/boot."
    else:
        info6 = "• Boots directly into high-performance developer console."

    safe_addstr(h // 2 - 4, max(0, (w - len(info1)) // 2), info1)
    safe_addstr(h // 2 - 3, max(0, (w - len(info1_de)) // 2), info1_de, curses.color_pair(1) | curses.A_BOLD)
    safe_addstr(h // 2 - 1, max(0, (w - len(info2)) // 2), info2, curses.color_pair(1) | curses.A_BOLD)
    safe_addstr(h // 2 + 1, max(0, (w - len(info3)) // 2), info3)
    safe_addstr(h // 2 + 2, max(0, (w - len(info4)) // 2), info4)
    safe_addstr(h // 2 + 3, max(0, (w - len(info5)) // 2), info5, curses.A_DIM)
    safe_addstr(h // 2 + 4, max(0, (w - len(info6)) // 2), info6, curses.color_pair(5))

    btn = "[ Press ENTER to Reboot Now  |  Press 'q' for Terminal ]"
    safe_addstr(h // 2 + 6, max(0, (w - len(btn)) // 2), btn, curses.color_pair(2))
    stdscr.refresh()

    while True:
        key = stdscr.getch()
        if key in [10, 13]:
            return "reboot"
        elif key in [ord('q'), 27]:
            return "quit"

    return "quit"


# ==============================================================================
# CLI Entry Point
# ==============================================================================

def main():
    parser = argparse.ArgumentParser(description="katusaOS Disk Installer (VM & Physical Drive)")
    parser.add_argument("--target", "-t", help="Target disk path (e.g. /dev/vda, /dev/sda)")
    parser.add_argument("--mode", "--boot-mode", choices=["auto", "gpt", "mbr"], default="auto",
                        help="Partition table and boot mode: gpt (UEFI), mbr (Legacy BIOS), or auto (default: auto)")
    parser.add_argument("--desktop", "-d", choices=["none", "xfce", "gnome", "plasma", "sway", "lxqt"],
                        default="none", help="Desktop environment to install: none, xfce, gnome, plasma, sway, lxqt (default: none)")
    parser.add_argument("--mbr", action="store_true", help="Install using Legacy MBR (msdos) partition table & BIOS bootloader")
    parser.add_argument("--gpt", action="store_true", help="Install using GPT partition table & UEFI bootloader")
    parser.add_argument("--yes", "-y", action="store_true", help="Automatically confirm wiping target disk")
    parser.add_argument("--list-disks", "-l", action="store_true", help="List available target disks and exit")
    parser.add_argument("--cli", action="store_true", help="Force text CLI mode instead of curses TUI")
    parser.add_argument("--force", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()

    # Block execution if already running on an installed disk system
    if is_already_installed() and not args.force:
        print(BANNER)
        print("[-] katusaOS is already installed on this disk.")
        print("[-] The 'katusa-install' utility cannot be run on an already installed system.\n")
        sys.exit(1)

    # Auto-elevate to root via sudo if run as regular user
    if os.geteuid() != 0:
        if shutil.which("sudo"):
            try:
                cmd = ["sudo", sys.executable, os.path.abspath(__file__)] + sys.argv[1:]
                os.execvp("sudo", cmd)
            except Exception as e:
                print(f"[-] Error: Failed to elevate to root via sudo: {e}", file=sys.stderr)
                sys.exit(1)
        else:
            print("[-] Error: katusa-install must be run as root (use 'sudo katusa-install').", file=sys.stderr)
            sys.exit(1)

    chosen_mode = "auto"
    if args.mbr:
        chosen_mode = "mbr"
    elif args.gpt:
        chosen_mode = "gpt"
    elif args.mode != "auto":
        chosen_mode = args.mode

    if args.list_disks:
        disks = get_available_disks()
        print("Available Target Disks:")
        for d in disks:
            boot_tag = " (Current Boot Disk)" if d["is_booted"] else ""
            print(f"  {d['path']:<12} {d['size_gb']:>6.1f} GiB  [{d['model']}]{boot_tag}")
        sys.exit(0)

    # Automated non-interactive mode
    if args.target:
        target_mode = detect_system_boot_mode() if chosen_mode == "auto" else chosen_mode
        mode_label = "GPT (UEFI)" if target_mode == "gpt" else "MBR (Legacy BIOS)"
        de_obj = next((d for d in SUPPORTED_DESKTOPS if d["id"] == args.desktop), SUPPORTED_DESKTOPS[0])
        if not args.yes:
            print(f"[!] WARNING: Target disk {args.target} will be completely ERASED.")
            print(f"[!] Partition Table & Boot Mode: {mode_label}")
            print(f"[!] Desktop Environment: {de_obj['name']}")
            if args.desktop != "none":
                print("[!] Note: Active internet connection is required to download GUI packages.")
            confirm = input("Type 'YES' to confirm: ").strip()
            if confirm.upper() != "YES":
                print("[-] Aborted by user.")
                sys.exit(1)

        print(f"[+] Starting automated installation onto {args.target} ({mode_label}, {de_obj['name']})...")
        perform_installation(args.target, boot_mode=target_mode, desktop=args.desktop)
        print(f"[✓] katusaOS installed successfully on {args.target} ({mode_label}, {de_obj['name']})!")
        sys.exit(0)

    # If terminal supports curses and not forced to CLI
    if not args.cli and sys.stdin.isatty():
        try:
            import curses
            result = curses.wrapper(lambda s: run_curses_gui(s, initial_mode=chosen_mode, initial_desktop=args.desktop))
            if result == "reboot":
                print("\n[+] Installation complete. Rebooting system now...")
                run_cmd("reboot 2>/dev/null || true", check=False)
                sys.exit(0)
            elif result in ["quit", False, True]:
                sys.exit(0)
            return
        except Exception as e:
            print(f"[!] Curses UI exited or unsupported: {e}. Falling back to CLI mode...")

    # Interactive CLI Mode Fallback
    print(BANNER)
    print("Welcome to katusaOS Disk Installer!\n")

    disks = get_available_disks()
    if not disks:
        print("[-] No suitable target disks found. Please attach a target drive.")
        sys.exit(1)

    print("Available Destination Disks:")
    for idx, d in enumerate(disks, 1):
        boot_tag = " (Current Boot Disk - Caution!)" if d["is_booted"] else ""
        print(f"  [{idx}] {d['path']:<12} {d['size_gb']:>6.1f} GiB  ({d['model']}){boot_tag}")

    print()
    while True:
        try:
            choice = input(f"Select disk number (1-{len(disks)}) or 'q' to quit: ").strip()
            if choice.lower() == 'q':
                sys.exit(0)
            c_idx = int(choice) - 1
            if 0 <= c_idx < len(disks):
                selected = disks[c_idx]
                break
        except ValueError:
            pass
        print("Invalid selection, please try again.")

    if chosen_mode != "auto":
        selected_mode = chosen_mode
    else:
        detected = detect_system_boot_mode()
        print("\nSelect Partition Table & Bootloader Type:")
        gpt_tag = " (Detected System Firmware)" if detected == "gpt" else ""
        mbr_tag = " (Detected System Firmware)" if detected == "mbr" else ""
        print(f"  [1] GPT (UEFI) - Modern GUID partition table{gpt_tag}")
        print(f"  [2] MBR (Legacy BIOS) - Classic MS-DOS partition table{mbr_tag}")
        default_choice = "1" if detected == "gpt" else "2"
        mode_input = input(f"Select mode [1/2, default {default_choice}]: ").strip()
        if mode_input == "2":
            selected_mode = "mbr"
        elif mode_input == "1":
            selected_mode = "gpt"
        else:
            selected_mode = detected

    if args.desktop != "none":
        selected_desktop = args.desktop
    else:
        print("\nSelect Desktop Environment:")
        for idx, de in enumerate(SUPPORTED_DESKTOPS, 1):
            tag = f" [{de['tag']}]" if de.get("tag") else ""
            print(f"  [{idx}] {de['name']:<22}{tag} - {de['desc']}")
        de_choice = input("Select desktop [1-6, default 1]: ").strip()
        try:
            de_idx = int(de_choice) - 1
            if 0 <= de_idx < len(SUPPORTED_DESKTOPS):
                selected_desktop = SUPPORTED_DESKTOPS[de_idx]["id"]
            else:
                selected_desktop = "none"
        except ValueError:
            selected_desktop = "none"

    de_obj = next((d for d in SUPPORTED_DESKTOPS if d["id"] == selected_desktop), SUPPORTED_DESKTOPS[0])
    mode_label = "GPT (UEFI)" if selected_mode == "gpt" else "MBR (Legacy BIOS)"
    print(f"\n[!] WARNING: All data on {selected['path']} ({selected['size_gb']} GiB) will be DESTROYED!")
    print(f"[!] Target Partition Scheme & Bootloader: {mode_label}")
    print(f"[!] Desktop Environment: {de_obj['name']}")
    if selected_desktop != "none":
        print("[!] Note: Active internet connection is required to download GUI packages.")
    confirm = input("Type 'YES' to proceed: ").strip()
    if confirm.upper() != "YES":
        print("[-] Installation aborted.")
        sys.exit(1)

    perform_installation(selected["path"], boot_mode=selected_mode, desktop=selected_desktop)
    print(f"\n[✓] katusaOS successfully installed to {selected['path']} ({mode_label}, {de_obj['name']})!")
    print("\nNext steps before rebooting:")
    print("  • VM Environment: Detach installer ISO from VM settings, then reboot.")
    print("  • USB Boot / PC : Detach installation media (USB drive), then reboot.")
    if selected_desktop != "none":
        print("  • Graphical desktop will launch automatically upon login / boot.")
    try:
        choice = input("\nReboot system now? [Y/n]: ").strip().lower()
        if choice in ["", "y", "yes"]:
            print("[+] Rebooting system...")
            run_cmd("reboot 2>/dev/null || true", check=False)
    except Exception:
        pass
    sys.exit(0)


if __name__ == "__main__":
    main()
