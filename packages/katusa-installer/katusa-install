        elif key in [10, 13]: # Enter
            selected_desktop = SUPPORTED_DESKTOPS[desktop_idx]["id"]
            break
        elif key in [ord('q'), 27]:
            return False

    # Screen 3: Confirmation Dialog
    stdscr.clear()
    h, w = stdscr.getmaxyx()

    desktop_obj = next((d for d in SUPPORTED_DESKTOPS if d["id"] == selected_desktop), SUPPORTED_DESKTOPS[0])
