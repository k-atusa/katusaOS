def cmd_install(args):
    installer_path = "/usr/local/bin/katusa-install"
    if not os.path.exists(installer_path):
        local_cand = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "katusa-installer", "katusa-install"))
        if os.path.exists(local_cand):
            installer_path = local_cand

    if not os.path.exists(installer_path):
        print(f"{Color.RED}Error: katusa-install tool not found.{Color.RESET}")
        sys.exit(1)

    cmd = ["sudo", installer_path] if os.geteuid() != 0 else [installer_path]
    if args.target:
        cmd.extend(["--target", args.target])
    if args.yes:
        cmd.append("--yes")
    if args.list_disks:
        cmd.append("--list-disks")
    if args.cli:
        cmd.append("--cli")

    try:
        os.execvp(cmd[0], cmd)
    except Exception as e:
        print(f"{Color.RED}Failed to execute installer: {e}{Color.RESET}")
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(
        prog="katusa",
        description="katusaOS Developer & Club Tool - Katusa Programming Club",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("-v", "--version", action="version", version=f"katusaOS CLI v{VERSION} ({CODENAME})")
    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    # info
    p_info = subparsers.add_parser("info", help="Display katusaOS system and club info")
    p_info.set_defaults(func=cmd_info)

    # doctor / tools
    p_doctor = subparsers.add_parser("doctor", help="Check developer toolchain & system health")
    p_doctor.set_defaults(func=cmd_doctor)

    p_tools = subparsers.add_parser("tools", help="List installed programming tools and compilers")
    p_tools.set_defaults(func=cmd_tools)

    # snippet
    p_snippet = subparsers.add_parser("snippet", help="Generate starter code templates for algorithms/projects")
    p_snippet.add_argument("lang", nargs="?", help="Language: cpp, python, rust, go, c")
    p_snippet.add_argument("-o", "--output", help="Save template to file")
    p_snippet.set_defaults(func=cmd_snippet)

    # help
    def cmd_help(a):
        parser.print_help()

    p_help = subparsers.add_parser("help", help="Show help information")
    p_help.set_defaults(func=cmd_help)

    # cheat
    p_cheat = subparsers.add_parser("cheat", help="Quick cheat sheets for Git, Tmux, GDB, QEMU")
    p_cheat.add_argument("topic", nargs="?", help="Topic: git, tmux, gdb, qemu")
    p_cheat.set_defaults(func=cmd_cheat)

    # install
    p_install = subparsers.add_parser("install", help="Launch interactive disk installer for UTM/QEMU/Disks")
    p_install.add_argument("--target", "-t", help="Target disk path (e.g. /dev/vda)")
    p_install.add_argument("--yes", "-y", action="store_true", help="Auto confirm wipe")
    p_install.add_argument("--list-disks", "-l", action="store_true", help="List target disks")
    p_install.add_argument("--cli", action="store_true", help="Use text CLI instead of curses TUI")
    p_install.set_defaults(func=cmd_install)

    args = parser.parse_args()
    if not args.command:
        cmd_info(args)
        print(f"Type {Color.YELLOW}'katusa --help'{Color.RESET} to see all available commands.")
    else:
        args.func(args)

if __name__ == "__main__":
    main()
