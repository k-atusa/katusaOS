def get_tool_version(cmd, flag="--version"):
    try:
        path = shutil.which(cmd)
        if not path:
            return None, "Not Installed"
        res = subprocess.run([cmd, flag], capture_output=True, text=True, timeout=2)
        out = (res.stdout or res.stderr).strip().splitlines()[0]
        # Truncate if too long
        if len(out) > 40:
            out = out[:37] + "..."
        return path, out
    except Exception as e:
        return None, f"Error: {e}"

def cmd_doctor(args):
    print_banner()
    print(f"{Color.BOLD}Running katusaOS Health & Environment Check...{Color.RESET}\n")

    tools = [
        ("Package Manager (apk)", "apk", "--version"),
        ("C Compiler (gcc)", "gcc", "-dumpversion"),
        ("C++ Compiler (g++)", "g++", "-dumpversion"),
        ("Clang Compiler", "clang", "--version"),
        ("Debugger (GDB)", "gdb", "--version"),
        ("Build System (Make)", "make", "--version"),
        ("Build System (CMake)", "cmake", "--version"),
        ("Git Version Control", "git", "--version"),
        ("Python 3 Runtime", "python3", "--version"),
        ("Rust Compiler (rustc)", "rustc", "--version"),
        ("Go Compiler (go)", "go", "version"),
        ("Node.js Runtime", "node", "--version"),
        ("Terminal Multiplexer (tmux)", "tmux", "-V"),
        ("Editor (Neovim/Vim)", "nvim", "--version"),
        ("Shell (Zsh)", "zsh", "--version"),
        ("Network Tools (curl)", "curl", "--version"),
    ]

    ok_count = 0
    total_count = len(tools)

    for name, binary, flag in tools:
        path, ver = get_tool_version(binary, flag)
        if path:
            ok_count += 1
            status = f"{Color.GREEN}[ OK ]{Color.RESET}"
            details = f"{Color.DIM}({ver}){Color.RESET}"
        else:
            status = f"{Color.YELLOW}[MISSING]{Color.RESET}"
            details = f"{Color.DIM}(Run 'sudo apk add {binary}' to install){Color.RESET}"
        print(f"  {status} {name:<28} {details}")

    print(f"\n{Color.BOLD}Summary:{Color.RESET} {ok_count}/{total_count} core developer tools available.")
    if ok_count == total_count:
        print(f"{Color.GREEN}{Color.BOLD}✓ All katusaOS developer tools are in prime condition! Happy Coding!{Color.RESET}\n")
    else:
        print(f"{Color.YELLOW}Some optional tools are missing. Install them if needed for your projects.{Color.RESET}\n")

def cmd_tools(args):
    cmd_doctor(args)

